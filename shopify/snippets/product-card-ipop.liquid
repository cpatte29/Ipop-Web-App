{% comment %}
  Snippet: product-card-ipop.liquid
  Purpose: Product card with fundraiser attribution support
  Usage: {% render 'product-card-ipop', product: product %}
{% endcomment %}

{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign product_url = product.url
  assign fundraiser = ''

  # Preserve fundraiser parameter in URL
  if request.get.fundraiser
    assign fundraiser = request.get.fundraiser
    assign product_url = product.url | append: '?fundraiser=' | append: fundraiser
  endif
-%}

<div class="product-card" style="background: #F5F5F5; border-radius: 12px; overflow: hidden; transition: all 0.3s ease; border: 2px solid transparent;">
  <a href="{{ product_url }}" class="product-card__link" style="text-decoration: none; color: inherit;">
    <!-- Product Image -->
    <div class="product-card__image-container" style="position: relative; aspect-ratio: 1; background: white; overflow: hidden;">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          alt="{{ product.featured_image.alt | escape }}"
          loading="lazy"
          width="400"
          height="400"
          style="width: 100%; height: 100%; object-fit: contain;"
        >
      {%- else -%}
        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 8rem;">
          🍿
        </div>
      {%- endif -%}

      {%- if on_sale -%}
        <div style="position: absolute; top: 1rem; right: 1rem; background: #E63946; color: white; padding: 0.5rem 1rem; border-radius: 4px; font-size: 1.2rem; font-weight: 700;">
          SALE
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info -->
    <div class="product-card__info" style="padding: 2rem;">
      <h3 style="font-size: 1.8rem; font-weight: 700; color: #2D2D2D; margin-bottom: 0.8rem;">
        {{ product.title }}
      </h3>

      {%- if product.description != blank -%}
        <p style="font-size: 1.4rem; color: #666; margin-bottom: 1.2rem; line-height: 1.6;">
          {{ product.description | strip_html | truncate: 80 }}
        </p>
      {%- endif -%}

      <!-- Price -->
      <div class="product-card__price" style="margin-bottom: 1.6rem;">
        {%- if on_sale -%}
          <span style="font-size: 2rem; font-weight: 700; color: #E63946;">
            {{ product.price | money }}
          </span>
          <span style="font-size: 1.6rem; color: #999; text-decoration: line-through; margin-left: 0.8rem;">
            {{ product.compare_at_price | money }}
          </span>
        {%- else -%}
          <span style="font-size: 2rem; font-weight: 700; color: #E63946;">
            {{ product.price | money }}
          </span>
        {%- endif -%}
      </div>

      <!-- Variants (if applicable) -->
      {%- if product.has_only_default_variant == false -%}
        <p style="font-size: 1.2rem; color: #666; margin-bottom: 1.2rem;">
          {{ product.variants.size }} options available
        </p>
      {%- endif -%}

      <!-- Quick Add to Cart -->
      {%- if product.available -%}
        <button
          type="button"
          class="product-card__add-to-cart"
          data-product-id="{{ product.id }}"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-fundraiser="{{ fundraiser }}"
          style="width: 100%; padding: 1.2rem; background: #E63946; color: white; font-size: 1.4rem; font-weight: 600; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease;"
          onmouseover="this.style.background='#c62e39'"
          onmouseout="this.style.background='#E63946'"
        >
          Add to Cart
        </button>
      {%- else -%}
        <button
          type="button"
          disabled
          style="width: 100%; padding: 1.2rem; background: #CCC; color: #666; font-size: 1.4rem; font-weight: 600; border: none; border-radius: 8px; cursor: not-allowed;"
        >
          Sold Out
        </button>
      {%- endif -%}
    </div>
  </a>
</div>

<style>
.product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  border-color: #E63946;
}
</style>
