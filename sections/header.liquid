{% comment %}
  Section: Header
  Main site navigation
{% endcomment %}

<header class="site-header">
  <div class="page-width">
    <nav class="main-nav">

      <!-- Logo — links to homepage -->
      <a href="/" class="header-logo" aria-label="{{ shop.name }} — Home">
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="200"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <span class="logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <!-- Primary Navigation -->
      <ul class="nav-menu" role="list">
        <li class="nav-item">
          <a href="/pages/start-fundraiser" class="nav-link">Fundraising</a>
        </li>
        <li class="nav-item">
          <a href="/collections/all" class="nav-link">Shop Popcorn</a>
        </li>
        <li class="nav-item">
          <a href="/pages/about-us" class="nav-link">About Us</a>
        </li>
      </ul>

      <!-- Right-side Actions -->
      <div class="nav-actions">
        <!-- Cart -->
        <a href="/cart" class="cart-link" aria-label="Shopping cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-label="{{ cart.item_count }} items in cart">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>

        <!-- Mobile Toggle -->
        <button class="mobile-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
      </div>

    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li><a href="/pages/start-fundraiser" class="mobile-link">Fundraising</a></li>
      <li><a href="/collections/all" class="mobile-link">Shop Popcorn</a></li>
      <li><a href="/pages/about-us" class="mobile-link">About Us</a></li>
      <li><a href="/cart" class="mobile-link">Cart ({{ cart.item_count }})</a></li>
    </ul>
  </div>
</header>

<style>
/* ── Header Shell ─────────────────────────────── */
.site-header {
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.site-header .page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* ── Nav Layout ───────────────────────────────── */
.main-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
  gap: 2rem;
}

/* ── Logo ─────────────────────────────────────── */
.header-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.header-logo img { max-height: 70px; width: auto; }
.logo-text {
  font-size: 2.2rem;
  font-weight: 700;
  color: #E63946;
}

/* ── Desktop Nav Menu ─────────────────────────── */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-item { position: relative; }

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.8rem 1.6rem;
  color: #2D2D2D;
  font-size: 1.5rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 6px;
  transition: color 0.2s, background 0.2s;
  white-space: nowrap;
}
.nav-link:hover { color: #E63946; background: #FFF0F1; }

/* ── Right Actions ────────────────────────────── */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-shrink: 0;
}

.cart-link {
  position: relative;
  display: flex;
  align-items: center;
  color: #2D2D2D;
  text-decoration: none;
  padding: 0.6rem;
  border-radius: 6px;
  transition: color 0.2s;
}
.cart-link:hover { color: #E63946; }

.cart-count {
  position: absolute;
  top: -4px;
  right: -6px;
  background: #E63946;
  color: #fff;
  border-radius: 50%;
  width: 18px;
  height: 18px;
  font-size: 1.1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── Mobile Toggle ────────────────────────────── */
.mobile-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.6rem;
}
.mobile-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: #2D2D2D;
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
}

/* ── Mobile Menu ──────────────────────────────── */
.mobile-menu {
  display: none;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 1.6rem 2rem;
}
.mobile-menu ul { list-style: none; margin: 0; padding: 0; }
.mobile-link {
  display: block;
  padding: 1.2rem 0;
  color: #2D2D2D;
  font-size: 1.6rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid #f0f0f0;
}
.mobile-link:hover { color: #E63946; }

/* ── Responsive ───────────────────────────────── */
@media (max-width: 768px) {
  .nav-menu { display: none; }
  .mobile-toggle { display: flex; }
  .mobile-menu.is-open { display: block; }
}
</style>

<script>
(function() {
  const toggle = document.querySelector('.mobile-toggle');
  const menu   = document.getElementById('mobile-menu');

  if (!toggle || !menu) return;

  toggle.addEventListener('click', function() {
    const isOpen = menu.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen);
    menu.setAttribute('aria-hidden', !isOpen);
  });
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ]
}
{% endschema %}
