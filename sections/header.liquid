{% comment %}
  Section: Header
  Main site navigation with dropdown menus
{% endcomment %}

<header class="site-header">
  <div class="page-width">
    <nav class="main-nav">

      <!-- Logo — links to homepage -->
      <a href="/" class="header-logo" aria-label="{{ shop.name }} — Home">
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="200"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <span class="logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <!-- Primary Navigation -->
      <ul class="nav-menu" role="list">

        <!-- About Us -->
        <li class="nav-item has-dropdown">
          <a href="/pages/about-us" class="nav-link" aria-haspopup="true">
            About Us
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="dropdown-menu" role="list">
            <li><a href="/pages/about-us" class="dropdown-link">Our Story</a></li>
            <li><a href="/pages/about-us#values" class="dropdown-link">Our Values</a></li>
            <li><a href="/pages/about-us#team" class="dropdown-link">Meet the Team</a></li>
          </ul>
        </li>

        <!-- Fundraising -->
        <li class="nav-item has-dropdown">
          <a href="/pages/start-fundraiser" class="nav-link" aria-haspopup="true">
            Fundraising
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="dropdown-menu" role="list">
            <li><a href="/pages/start-fundraiser" class="dropdown-link">Start a Fundraiser</a></li>
            <li><a href="/pages/how-it-works" class="dropdown-link">How It Works</a></li>
            <li><a href="/pages/fundraiser" class="dropdown-link">Find a Fundraiser</a></li>
          </ul>
        </li>

      </ul>

      <!-- Right-side Actions -->
      <div class="nav-actions">
        <!-- Cart -->
        <a href="/cart" class="cart-link" aria-label="Shopping cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-label="{{ cart.item_count }} items in cart">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>

        <!-- CTA Button -->
        <a href="/pages/start-fundraiser" class="btn-cta">Start a Fundraiser</a>

        <!-- Mobile Toggle -->
        <button class="mobile-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
      </div>

    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li>
        <a href="/pages/about-us" class="mobile-link">About Us</a>
        <ul>
          <li><a href="/pages/about-us" class="mobile-sub-link">Our Story</a></li>
          <li><a href="/pages/about-us#values" class="mobile-sub-link">Our Values</a></li>
          <li><a href="/pages/about-us#team" class="mobile-sub-link">Meet the Team</a></li>
        </ul>
      </li>
      <li>
        <a href="/pages/start-fundraiser" class="mobile-link">Fundraising</a>
        <ul>
          <li><a href="/pages/start-fundraiser" class="mobile-sub-link">Start a Fundraiser</a></li>
          <li><a href="/pages/how-it-works" class="mobile-sub-link">How It Works</a></li>
          <li><a href="/pages/fundraiser" class="mobile-sub-link">Find a Fundraiser</a></li>
        </ul>
      </li>
      <li><a href="/cart" class="mobile-link">Cart ({{ cart.item_count }})</a></li>
    </ul>
  </div>
</header>

<style>
/* ── Header Shell ─────────────────────────────── */
.site-header {
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.site-header .page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* ── Nav Layout ───────────────────────────────── */
.main-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
  gap: 2rem;
}

/* ── Logo ─────────────────────────────────────── */
.header-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.header-logo img { max-height: 50px; width: auto; }
.logo-text {
  font-size: 2.2rem;
  font-weight: 700;
  color: #E63946;
}

/* ── Desktop Nav Menu ─────────────────────────── */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-item { position: relative; }

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.8rem 1.4rem;
  color: #2D2D2D;
  font-size: 1.5rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 6px;
  transition: color 0.2s, background 0.2s;
  white-space: nowrap;
}
.nav-link:hover { color: #E63946; background: #FFF0F1; }

.chevron {
  transition: transform 0.2s;
  flex-shrink: 0;
}

/* ── Dropdown ─────────────────────────────────── */
.dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  min-width: 210px;
  background: #fff;
  border: 1px solid #eee;
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  list-style: none;
  margin: 0;
  padding: 0.6rem 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-6px);
  transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  z-index: 200;
}

.nav-item.has-dropdown:hover .dropdown-menu,
.nav-item.has-dropdown:focus-within .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.nav-item.has-dropdown:hover .chevron,
.nav-item.has-dropdown:focus-within .chevron {
  transform: rotate(180deg);
}

.dropdown-link {
  display: block;
  padding: 1rem 1.8rem;
  color: #2D2D2D;
  font-size: 1.4rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.2s, background 0.2s;
}
.dropdown-link:hover { color: #E63946; background: #FFF0F1; }

/* ── Right Actions ────────────────────────────── */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-shrink: 0;
}

.cart-link {
  position: relative;
  display: flex;
  align-items: center;
  color: #2D2D2D;
  text-decoration: none;
  padding: 0.6rem;
  border-radius: 6px;
  transition: color 0.2s;
}
.cart-link:hover { color: #E63946; }

.cart-count {
  position: absolute;
  top: -4px;
  right: -6px;
  background: #E63946;
  color: #fff;
  border-radius: 50%;
  width: 18px;
  height: 18px;
  font-size: 1.1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cta {
  background: #E63946;
  color: #fff;
  padding: 0.9rem 1.8rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 1.4rem;
  white-space: nowrap;
  transition: background 0.2s, transform 0.2s;
}
.btn-cta:hover { background: #c62e39; transform: translateY(-1px); }

/* ── Mobile Toggle ────────────────────────────── */
.mobile-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.6rem;
}
.mobile-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: #2D2D2D;
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
}

/* ── Mobile Menu ──────────────────────────────── */
.mobile-menu {
  display: none;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 1.6rem 2rem;
}
.mobile-menu ul { list-style: none; margin: 0; padding: 0; }
.mobile-link {
  display: block;
  padding: 1.2rem 0;
  color: #2D2D2D;
  font-size: 1.6rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid #f0f0f0;
}
.mobile-sub-link {
  display: block;
  padding: 0.8rem 1.6rem;
  color: #666;
  font-size: 1.4rem;
  text-decoration: none;
}
.mobile-sub-link:hover { color: #E63946; }

/* ── Responsive ───────────────────────────────── */
@media (max-width: 768px) {
  .nav-menu { display: none; }
  .btn-cta { display: none; }
  .mobile-toggle { display: flex; }
  .mobile-menu.is-open { display: block; }
}
</style>

<script>
(function() {
  const toggle = document.querySelector('.mobile-toggle');
  const menu   = document.getElementById('mobile-menu');

  if (!toggle || !menu) return;

  toggle.addEventListener('click', function() {
    const isOpen = menu.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen);
    menu.setAttribute('aria-hidden', !isOpen);
  });
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 250,
      "step": 10,
      "default": 160,
      "unit": "px",
      "label": "Logo width"
    }
  ]
}
{% endschema %}
