{% comment %}
  Section: Footer
  Site footer with contact info and links
{% endcomment %}

<footer class="site-footer" style="background: #2D2D2D; color: white; padding: 4rem 0 2rem;">
  <div class="page-width">
    <div class="footer-content" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 3.2rem; margin-bottom: 3.2rem;">
      <!-- Brand -->
      <div>
        <!-- Logo area — upload via Customize > Footer > Footer logo -->
        <a href="/" style="display: inline-block; margin-bottom: 1.6rem;">
          {%- if section.settings.footer_logo -%}
            <img
              src="{{ section.settings.footer_logo | image_url: width: 220 }}"
              alt="{{ shop.name }}"
              width="250"
              height="auto"
              style="max-height: 70px; width: auto; object-fit: contain;"
            >
          {%- else -%}
            <div style="
              width: 200px;
              height: 64px;
              background: rgba(255,255,255,0.08);
              border: 2px dashed rgba(255,255,255,0.25);
              border-radius: 8px;
              display: flex;
              align-items: center;
              justify-content: center;
            ">
              <span style="color: rgba(255,255,255,0.4); font-size: 1.2rem; text-align: center; line-height: 1.4;">
                Logo placeholder<br>
                <em style="font-style: normal; font-size: 1rem;">Upload in Theme Editor</em>
              </span>
            </div>
          {%- endif -%}
        </a>

        <p style="color: #FFD60A; font-size: 1.4rem; margin: 0 0 1.6rem; font-weight: 600;">
          Made with ❤️ in Memphis 
        </p>

        <!-- Social Links -->
        <div style="display: flex; gap: 1.2rem;">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" style="color: white;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" style="color: white;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="#2D2D2D" stroke-width="2"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="#2D2D2D" stroke-width="2"></line>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" style="color: white;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Links Column 1 -->
      <div>
        <h4 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 1.6rem;">Fundraising</h4>
        <ul style="list-style: none; margin: 0; padding: 0;">
          <li style="margin-bottom: 0.8rem;">
            <a href="/pages/start-fundraiser" style="color: #CCC; text-decoration: none; font-size: 1.4rem;">Start a Fundraiser</a>
          </li>
          <li style="margin-bottom: 0.8rem;">
            <a href="/pages/start-fundraiser" style="color: #CCC; text-decoration: none; font-size: 1.4rem;">How It Works</a>
          </li>
        </ul>
      </div>

      <!-- Links Column 2 -->
      <div>
        <h4 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 1.6rem;">Products</h4>
        <ul style="list-style: none; margin: 0; padding: 0;">
          <li style="margin-bottom: 0.8rem;">
            <a href="/collections/all" style="color: #CCC; text-decoration: none; font-size: 1.4rem;">Shop Popcorn</a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 1.6rem;">Contact</h4>
        {%- if section.settings.contact_phone -%}
          <p style="color: #CCC; margin-bottom: 0.8rem; font-size: 1.4rem;">
            Phone: {{ section.settings.contact_phone }}
          </p>
        {%- endif -%}
        {%- if section.settings.contact_email -%}
          <p style="color: #CCC; margin-bottom: 0.8rem; font-size: 1.4rem;">
            Email: <a href="mailto:{{ section.settings.contact_email }}" style="color: #FFED00; text-decoration: none;">{{ section.settings.contact_email }}</a>
          </p>
        {%- endif -%}
        {%- if section.settings.address -%}
          <p style="color: #CCC; font-size: 1.4rem; line-height: 1.6;">
            {{ section.settings.address }}
          </p>
        {%- endif -%}
      </div>
    </div>

    <!-- Copyright -->
    <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 2rem; text-align: center;">
      <p style="color: #999; font-size: 1.4rem; margin: 0;">
        © {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone number",
      "default": "(901) 239-4767"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "contact@ipopgourmet.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "1605 N Germantown Pkwy Ste 112\nCordova, TN 38018"
    }
  ]
}
{% endschema %}
