{% comment %}
  Template: page.how-it-works.liquid
  Purpose: Fundraising "How It Works" overview page
  Usage: In Shopify admin create Page with handle "how-it-works", assign this template
{% endcomment %}

{{ 'custom-home.css' | asset_url | stylesheet_tag }}

<!-- Hero Section -->
<section style="background: linear-gradient(135deg, #E63946 0%, #c62e39 100%); color: white; padding: 8rem 0; text-align: center;">
  <div class="page-width" style="max-width: 900px; margin: 0 auto; padding: 0 2rem;">
    <h1 style="font-size: 5rem; font-weight: 700; line-height: 1.15; margin-bottom: 2rem;">
      Fundraising Made Simple
    </h1>
    <p style="font-size: 2rem; opacity: 0.95; max-width: 680px; margin: 0 auto 3.2rem; line-height: 1.6;">
      Start selling gourmet popcorn online in 3 easy steps. No upfront costs. 50% profit for your group. It's that simple!
    </p>
    <a
      href="/pages/start-fundraiser"
      style="display: inline-block; background: white; color: #E63946; font-size: 1.8rem; font-weight: 700; padding: 1.6rem 4rem; border-radius: 10px; text-decoration: none; box-shadow: 0 4px 16px rgba(0,0,0,0.2); transition: all 0.2s;"
      onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(0,0,0,0.3)';"
      onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 16px rgba(0,0,0,0.2)';"
    >
      Start Your Fundraiser
    </a>
  </div>
</section>

<!-- How It Works - 3 Steps -->
<section style="padding: 8rem 0; background: white;">
  <div class="page-width" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div style="text-align: center; margin-bottom: 5rem;">
      <h2 style="font-size: 3.6rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1.2rem;">How It Works</h2>
      <p style="font-size: 1.8rem; color: #666; max-width: 600px; margin: 0 auto; line-height: 1.6;">
        Three simple steps to fundraising success
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3.2rem;">

      <!-- Step 1 -->
      <article style="background: #F5F5F5; border-radius: 14px; padding: 3.2rem; text-align: center;">
        <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #E63946, #c62e39); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; font-weight: 700; margin: 0 auto 2rem;">1</div>
        <h3 style="font-size: 2.2rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1.2rem;">Sign Up & Share</h3>
        <p style="font-size: 1.5rem; color: #666; line-height: 1.7;">
          Create your free fundraiser page in minutes. Get a personalized link to share with supporters via email, social media, or text.
        </p>
      </article>

      <!-- Step 2 -->
      <article style="background: #F5F5F5; border-radius: 14px; padding: 3.2rem; text-align: center;">
        <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #E63946, #c62e39); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; font-weight: 700; margin: 0 auto 2rem;">2</div>
        <h3 style="font-size: 2.2rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1.2rem;">Supporters Order Online</h3>
        <p style="font-size: 1.5rem; color: #666; line-height: 1.7;">
          Friends, family, and supporters shop gourmet popcorn directly from your fundraiser page. Orders ship straight to their door - no inventory management!
        </p>
      </article>

      <!-- Step 3 -->
      <article style="background: #F5F5F5; border-radius: 14px; padding: 3.2rem; text-align: center;">
        <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #E63946, #c62e39); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; font-weight: 700; margin: 0 auto 2rem;">3</div>
        <h3 style="font-size: 2.2rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1.2rem;">Earn 50% Profit</h3>
        <p style="font-size: 1.5rem; color: #666; line-height: 1.7;">
          Your group earns 50% profit on every sale. We handle payment processing, shipping, and customer service. You get paid automatically!
        </p>
      </article>

    </div>
  </div>
</section>

