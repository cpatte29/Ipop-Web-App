        <span style="font-size: 8rem;">🍿</span>
      </div>
    </div>
  </div>
</section>

<!-- Results Section -->
<section style="padding: 8rem 0; background: #E63946; color: white;">
  <div class="page-width" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
