{% comment %}
  Template: cart.liquid
  Shopify cart page with fundraiser attribution support
{% endcomment %}

{{ 'ipop-cart.js' | asset_url | script_tag }}

<div class="page-width" style="max-width: 1200px; margin: 0 auto; padding: 4rem 2rem;">

  <!-- Cart Header -->
  <header style="text-align: center; margin-bottom: 4rem;">
    <h1 style="font-size: 4rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1rem;">Your Cart</h1>
    {%- if cart.item_count > 0 -%}
      <p style="font-size: 1.6rem; color: #666;">You have {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }} in your cart</p>
    {%- endif -%}
  </header>

  {%- if cart.item_count > 0 -%}

    <!-- Fundraiser Attribution Banner -->
    {%- if cart.note contains 'Supporting:' -%}
      <div style="background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%); color: white; padding: 2rem; border-radius: 12px; margin-bottom: 3rem; text-align: center;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎯 Supporting a Fundraiser!</div>
        <div style="font-size: 1.6rem; opacity: 0.95;">{{ cart.note }}</div>
        <div style="font-size: 1.4rem; margin-top: 0.5rem; opacity: 0.9;">50% of your purchase supports this fundraiser</div>
      </div>
    {%- endif -%}

    <div style="display: grid; grid-template-columns: 1fr; gap: 3rem;">

      <!-- Cart Items -->
      <div>
        {%- for item in cart.items -%}
          <div style="background: #F5F5F5; border-radius: 12px; padding: 2rem; margin-bottom: 1.6rem; display: grid; grid-template-columns: 120px 1fr auto; gap: 2rem; align-items: center;">

            <!-- Product Image -->
            <div style="aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: white;">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 240 }}"
                  alt="{{ item.title | escape }}"
                  style="width: 100%; height: 100%; object-fit: contain; padding: 1rem;"
                  loading="lazy"
                >
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem;">
                  🍿
                </div>
              {%- endif -%}
            </div>

            <!-- Product Details -->
            <div>
              <h3 style="font-size: 1.8rem; font-weight: 700; color: #2D2D2D; margin-bottom: 0.5rem;">
                {{ item.product.title }}
              </h3>
              {%- if item.variant.title != 'Default Title' -%}
                <p style="font-size: 1.4rem; color: #666; margin-bottom: 0.5rem;">{{ item.variant.title }}</p>
              {%- endif -%}
              <p style="font-size: 1.6rem; font-weight: 600; color: #E63946;">
                {{ item.final_line_price | money }}
              </p>

              <!-- Quantity Controls -->
              <div style="display: flex; align-items: center; gap: 1rem; margin-top: 1rem;">
                <button
                  class="qty-btn"
                  data-line="{{ forloop.index }}"
                  data-qty="{{ item.quantity | minus: 1 }}"
                  style="width: 32px; height: 32px; border: 2px solid #CCC; background: white; border-radius: 4px; cursor: pointer; font-size: 1.6rem; font-weight: 700; color: #2D2D2D;"
                  {%- if item.quantity <= 1 -%}disabled{%- endif -%}
                >
                  −
                </button>
                <span style="font-size: 1.6rem; font-weight: 600; min-width: 30px; text-align: center;">{{ item.quantity }}</span>
                <button
                  class="qty-btn"
                  data-line="{{ forloop.index }}"
                  data-qty="{{ item.quantity | plus: 1 }}"
                  style="width: 32px; height: 32px; border: 2px solid #CCC; background: white; border-radius: 4px; cursor: pointer; font-size: 1.6rem; font-weight: 700; color: #2D2D2D;"
                >
                  +
                </button>
              </div>
            </div>

            <!-- Remove Button -->
            <div>
              <button
                class="remove-item"
                data-line="{{ forloop.index }}"
                style="background: none; border: none; color: #E63946; cursor: pointer; font-size: 1.4rem; text-decoration: underline;"
              >
                Remove
              </button>
            </div>

          </div>
        {%- endfor -%}
      </div>

    </div>

    <!-- Cart Summary -->
    <div style="background: #2D2D2D; color: white; padding: 3rem; border-radius: 12px; margin-top: 3rem; max-width: 500px; margin-left: auto;">
      <h2 style="font-size: 2.4rem; font-weight: 700; margin-bottom: 2rem;">Order Summary</h2>

      <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-size: 1.6rem;">
        <span>Subtotal:</span>
        <span>{{ cart.total_price | money }}</span>
      </div>

      {%- if cart.note contains 'Supporting:' -%}
        <div style="background: rgba(76, 175, 80, 0.2); padding: 1.6rem; border-radius: 8px; margin: 2rem 0; border: 2px solid #4CAF50;">
          <div style="font-size: 1.4rem; margin-bottom: 0.5rem; color: #4CAF50; font-weight: 600;">Fundraiser Impact:</div>
          <div style="font-size: 2rem; font-weight: 700;">{{ cart.total_price | times: 0.5 | money }}</div>
          <div style="font-size: 1.2rem; opacity: 0.8; margin-top: 0.5rem;">goes to the fundraiser (50% profit)</div>
        </div>
      {%- endif -%}

      <p style="font-size: 1.3rem; color: #CCC; margin-bottom: 2rem;">Shipping & taxes calculated at checkout</p>

      <form action="/cart" method="post" novalidate>
        <button
          type="submit"
          name="checkout"
          style="width: 100%; background: #E63946; color: white; border: none; padding: 1.8rem; border-radius: 8px; font-size: 1.8rem; font-weight: 700; cursor: pointer; transition: background 0.3s;"
          onmouseover="this.style.background='#c62e39'"
          onmouseout="this.style.background='#E63946'"
        >
          Proceed to Checkout
        </button>
      </form>

      <a
        href="/collections/all"
        style="display: block; text-align: center; margin-top: 1.6rem; color: #FFD60A; text-decoration: none; font-size: 1.4rem;"
      >
        ← Continue Shopping
      </a>
    </div>

  {%- else -%}

    <!-- Empty Cart -->
    <div style="text-align: center; padding: 6rem 2rem;">
      <div style="font-size: 8rem; margin-bottom: 2rem;">🛒</div>
      <h2 style="font-size: 3.2rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1rem;">Your cart is empty</h2>
      <p style="font-size: 1.8rem; color: #666; margin-bottom: 3rem;">Add some delicious gourmet popcorn to get started!</p>

      <a
        href="/collections/all"
        style="display: inline-block; background: #E63946; color: white; padding: 1.6rem 3.2rem; border-radius: 8px; font-size: 1.6rem; font-weight: 700; text-decoration: none; transition: background 0.3s;"
        onmouseover="this.style.background='#c62e39'"
        onmouseout="this.style.background='#E63946'"
      >
        Shop Gourmet Popcorn
      </a>
    </div>

  {%- endif -%}

</div>

<script>
// Handle quantity changes
document.querySelectorAll('.qty-btn').forEach(button => {
  button.addEventListener('click', function() {
    const line = this.dataset.line;
    const qty = this.dataset.qty;

    // Update via Shopify cart API
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, quantity: qty })
    })
    .then(response => response.json())
    .then(() => {
      window.location.reload();
    })
    .catch(error => {
      console.error('Error updating quantity:', error);
      alert('Error updating quantity. Please try again.');
    });
  });
});

// Handle item removal
document.querySelectorAll('.remove-item').forEach(button => {
  button.addEventListener('click', function() {
    if (confirm('Remove this item from your cart?')) {
      const line = this.dataset.line;

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: line, quantity: 0 })
      })
      .then(response => response.json())
      .then(() => {
        window.location.reload();
      })
      .catch(error => {
        console.error('Error removing item:', error);
        alert('Error removing item. Please try again.');
      });
    }
  });
});
</script>

<style>
.qty-btn:hover:not([disabled]) {
  background: #F0F0F0 !important;
  border-color: #E63946 !important;
}

.qty-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.remove-item:hover {
  color: #c62e39 !important;
}

@media (max-width: 768px) {
  h1 { font-size: 3.2rem !important; }

  [style*="grid-template-columns: 120px 1fr auto"] {
    grid-template-columns: 80px 1fr !important;
    gap: 1rem !important;
  }

  .remove-item {
    grid-column: 1 / -1;
    text-align: left;
    margin-top: 1rem;
  }
}
</style>
