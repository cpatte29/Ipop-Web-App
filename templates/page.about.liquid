<!-- Final CTA -->
<section style="padding: 8rem 0; background: #F5F5F5;">
  <div class="page-width" style="max-width: 900px; margin: 0 auto; padding: 0 2rem; text-align: center;">
    <h2 style="font-size: 3.6rem; font-weight: 700; color: #2D2D2D; margin-bottom: 2rem;">Join the iPOP Family</h2>
    <p style="font-size: 1.8rem; color: #666; line-height: 1.6; margin-bottom: 4rem; max-width: 700px; margin-left: auto; margin-right: auto;">
