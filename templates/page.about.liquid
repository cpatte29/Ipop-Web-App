{% comment %}
  Template: page.about.liquid
  Purpose: About Us page — Our Story, Mission, Values, and Impact
  Usage: In Shopify admin create a Page, set URL to "about-us", assign this template
{% endcomment %}

{{ 'custom-home.css' | asset_url | stylesheet_tag }}

<!-- Hero Section -->
<section style="background: linear-gradient(135deg, #E63946 0%, #c62e39 100%); color: white; padding: 8rem 0; text-align: center;">
  <div class="page-width" style="max-width: 900px; margin: 0 auto; padding: 0 2rem;">
    <h1 style="font-size: 5rem; font-weight: 700; line-height: 1.15; margin-bottom: 2rem;">
      We're iPOP Gourmet Popcorn
    </h1>
    <p style="font-size: 2rem; opacity: 0.95; max-width: 680px; margin: 0 auto; line-height: 1.6;">
      Making fundraising simple, delicious, and profitable for schools, teams, and organizations across the country.
    </p>
  </div>
</section>

<!-- Our Story Section -->
<section style="padding: 8rem 0; background: white;">
  <div class="page-width" style="max-width: 1100px; margin: 0 auto; padding: 0 2rem;">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h2 style="font-size: 3.6rem; font-weight: 700; color: #2D2D2D; margin-bottom: 1.2rem;">Our Story</h2>
      <p style="font-size: 1.8rem; color: #666;">Born from a love of popcorn and a passion for helping communities</p>
    </div>

    <div style="max-width: 900px; margin: 0 auto; font-size: 1.7rem; line-height: 1.8; color: #555;">
      <p style="margin-bottom: 2.4rem;">
        iPOP Gourmet Popcorn started with a simple idea: fundraising shouldn't be complicated, stressful, or require upfront investment. We believed there had to be a better way for schools, sports teams, and community organizations to raise the funds they need.
      </p>
      <p style="margin-bottom: 2.4rem;">
        After years of experience in the fundraising industry, we saw firsthand the challenges groups faced - from managing inventory to collecting money to delivering orders. We knew technology could solve these problems and make fundraising accessible to everyone.
      </p>
      <p style="margin-bottom: 0;">
        Today, we're proud to serve thousands of organizations nationwide with our 100% online fundraising platform. Our gourmet popcorn practically sells itself, and our technology handles everything else - so you can focus on what matters most.
      </p>
    </div>
  </div>
</section>

