<script>
// Check for fundraiser attribution
(function() {
  'use strict';

  // Get fundraiser from URL or sessionStorage
  function getFundraiser() {
    const urlParams = new URLSearchParams(window.location.search);
    const fundraiserParam = urlParams.get('fundraiser') || urlParams.get('id');

    if (fundraiserParam) {
      sessionStorage.setItem('current_fundraiser', fundraiserParam);
      return fundraiserParam;
    }

    return sessionStorage.getItem('current_fundraiser');
  }

  // Load fundraiser data
  function loadFundraiserData(slug) {
    try {
      const fundraisers = JSON.parse(localStorage.getItem('ipop_fundraisers') || '[]');
      return fundraisers.find(f => f.slug === slug);
    } catch (e) {
      console.error('Error loading fundraiser data:', e);
      return null;
    }
  }

  // Show fundraiser banner
  function showFundraiserBanner(fundraiserSlug) {
    const banner = document.getElementById('fundraiser-banner');
    const nameElement = document.getElementById('fundraiser-name');

    if (!banner || !nameElement) return;

    const fundraiser = loadFundraiserData(fundraiserSlug);

    if (fundraiser) {
      nameElement.textContent = fundraiser.orgName;
    } else {
      nameElement.textContent = 'a fundraiser';
    }

    banner.style.display = 'block';
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    const fundraiserSlug = getFundraiser();

    if (fundraiserSlug) {
      showFundraiserBanner(fundraiserSlug);
    }
  });
})();
</script>
